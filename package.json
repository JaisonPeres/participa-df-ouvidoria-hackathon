{
  "name": "participa-df-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Participa DF Ouvidoria Hackathon - Monorepo",
  "scripts": {
    "start": "tsx scripts/setup.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "env:setup": "tsx scripts/setup-env.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.2.5",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
